{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "e=\"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-commands.js\"; r=\"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-rules.json\"; i=$(cat); case \"$i\" in *\"agent_guard --install\"*) printf %s \"$i\" | node -e 'let s=\"\";process.stdin.on(\"data\",(d)=>s+=d).on(\"end\",()=>{let c=\"\";try{c=String(JSON.parse(s).tool_input.command||\"\")}catch{}process.exit(/^[^;&|<>`()\\n\\r]*-m dev_lab\\.dev\\.agent_guard --install( --force)?$/.test(c.trim())?0:1)})' && exit 0;; esac; [ -f \"$e\" ] && [ -f \"$r\" ] || { echo \"agent-guard: no engine at $e or no rules at $r -- refused (fail closed); repair: node \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\\\" -m dev_lab.dev.agent_guard --install\" >&2; exit 2; }; printf %s \"$i\" | node \"$e\" \"$r\" || { echo \"agent-guard: the engine exited $? -- refused (fail closed)\" >&2; exit 2; }",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\" -m dev_lab.dev.hookdispatch PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\" -m dev_lab.dev.hookdispatch PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\" -m dev_lab.dev.hookdispatch PostToolUseFailure",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\" -m dev_lab.dev.hookdispatch UserPromptSubmit",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\" -m dev_lab.dev.hookdispatch Stop",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\" -m dev_lab.dev.hookdispatch SubagentStop",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\" -m dev_lab.dev.hookdispatch SessionStart",
            "timeout": 780
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sharp-review@cc-market": false
  }
}
